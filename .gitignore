# ========================================================
# OmniGit Root Git Ignore Configuration
# ========================================================

# --- Dependencies ---
node_modules/
app/node_modules/
.pnp
.pnp.js

# --- Build Output & Distribution ---
dist/
app/dist/
dist-electron/
app/dist-electron/
dist-ssr/
app/dist-ssr/
release/
app/release/
.cache/
app/.cache/
*.tsbuildinfo

# --- Binaries & Installers (Publish to GitHub Releases) ---
# Executables and archives should be distributed via GitHub Releases, NOT committed into git history
*.exe
*.dmg
*.pkg
*.app
*.deb
*.rpm
*.zip
*.tar.gz
*.7z

# Exception: Preserve built-in portable NSIS compiler toolchain for zero-dependency Windows setup packaging
!scripts/tools/nsis/**
!scripts/tools/nsis/NSIS.exe
!scripts/tools/nsis/makensis.exe
!scripts/tools/nsis/elevate.exe
!scripts/tools/nsis/Bin/**
!scripts/tools/nsis/Contrib/**
!scripts/tools/nsis/Include/**
!scripts/tools/nsis/Menu/**
!scripts/tools/nsis/Plugins/**
!scripts/tools/nsis/Stubs/**
!scripts/tools/nsis/linux/**
!scripts/tools/nsis/mac/**

# --- Temporary / Scratch / Test Files ---
*.tmp
*.temp
test.tmp
app/test.tmp
scratch/

# --- Logs ---
logs/
app/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Environment & Local Overrides ---
.env
.env.local
.env.*.local
*.local

# --- OS & Editor Metadata ---
.DS_Store
Thumbs.db
Desktop.ini
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.csdn_profile/
