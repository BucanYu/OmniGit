{
  "name": "omnigit",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:electron": "tsc -p electron/tsconfig.json && node -e \"require('fs').writeFileSync('dist-electron/package.json', JSON.stringify({type:'commonjs'}))\"",
    "build:all": "npm run build && npm run build:electron",
    "electron:start": "electron .",
    "electron:preview": "npm run build:all && electron .",
    "package:win": "npm run build:all && node scripts/package.cjs",
    "package:mac": "npm run build:all && node scripts/package-mac.cjs --arch=arm64",
    "package:mac:x64": "npm run build:all && node scripts/package-mac.cjs --arch=x64",
    "package:mac:all": "npm run build:all && node scripts/package-mac.cjs --arch=all",
    "package:all": "npm run package:win && npm run package:mac",
    "generate:icns": "node scripts/generate-icns.cjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-virtual": "^3.13.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.42.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  }
}
