  "sql": {
    "c0": "SELECT u.id, u.username, u.email, count(c.id) AS total_commits FROM users u LEFT JOIN commits c ON u.id = c.author_id WHERE u.status = 'ACTIVE' AND c.created_at >= '2026-01-01' GROUP BY u.id, u.username, u.email HAVING count(c.id) > 10 ORDER BY total_commits DESC LIMIT 50;",
    "c1": "SELECT u.id, u.username, u.email, count(c.id) AS total_commits\nFROM users u\nLEFT\nJOIN commits c\n  ON u.id = c.author_id\nWHERE u.status = 'ACTIVE'\n  AND c.created_at >= '2026-01-01'\nGROUP BY u.id, u.username, u.email\nHAVING count(c.id) > 10\nORDER BY total_commits DESC\nLIMIT 50;",
